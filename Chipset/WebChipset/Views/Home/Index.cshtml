@{
    ViewData["Title"] = "Inicio";
}

<!-- Hero Section -->
<section id="hero" class="hero section dark-background">

    <!-- Asegúrate de tener esta imagen o una parecida en tu carpeta -->
    <img src="~/assets/img/hero-bg.jpg" alt="" data-aos="fade-in">

    <div class="container">

        <div class="row justify-content-center text-center" data-aos="fade-up" data-aos-delay="100">
            <div class="col-xl-6 col-lg-8">
                <h2>Potencia tu PC con ChipSet<span>.</span></h2>
                <p>Los mejores componentes de hardware al mejor precio del mercado</p>
            </div>
        </div>

        <div class="row gy-4 mt-5 justify-content-center" data-aos="fade-up" data-aos-delay="200">
            <div class="col-xl-2 col-md-4" data-aos="fade-up" data-aos-delay="300">
                <div class="icon-box">
                    <i class="bi bi-cpu"></i>
                    <h3><a href="">Procesadores</a></h3>
                </div>
            </div>
            <div class="col-xl-2 col-md-4" data-aos="fade-up" data-aos-delay="400">
                <div class="icon-box">
                    <i class="bi bi-gpu-card"></i>
                    <h3><a href="">Gráficas</a></h3>
                </div>
            </div>
            <div class="col-xl-2 col-md-4" data-aos="fade-up" data-aos-delay="500">
                <div class="icon-box">
                    <i class="bi bi-memory"></i>
                    <h3><a href="">Memorias</a></h3>
                </div>
            </div>
            <div class="col-xl-2 col-md-4" data-aos="fade-up" data-aos-delay="600">
                <div class="icon-box">
                    <i class="bi bi-motherboard"></i>
                    <h3><a href="">Placas Madre</a></h3>
                </div>
            </div>
            <div class="col-xl-2 col-md-4" data-aos="fade-up" data-aos-delay="700">
                <div class="icon-box">
                    <i class="bi bi-headset"></i>
                    <h3><a href="">Periféricos</a></h3>
                </div>
            </div>
        </div>

    </div>

</section>

<!-- About Section -->
<section id="about" class="about section">

    <div class="container" data-aos="fade-up" data-aos-delay="100">

        <div class="row gy-4">
            <div class="col-lg-6 order-1 order-lg-2">
                <img src="~/assets/img/about.jpg" class="img-fluid" alt="">
            </div>
            <div class="col-lg-6 order-2 order-lg-1 content">
                <h3>Sobre ChipSet</h3>
                <p class="fst-italic">
                    Somos líderes en la distribución de tecnología informática en la región.
                </p>
                <ul>
                    <li><i class="bi bi-check2-all"></i> <span>Garantía real en todos nuestros productos.</span></li>
                    <li><i class="bi bi-check2-all"></i> <span>Asesoramiento técnico especializado para tu build.</span></li>
                    <li><i class="bi bi-check2-all"></i> <span>Envíos seguros a todo el país.</span></li>
                </ul>
                <p>
                    En ChipSet entendemos tu pasión por la tecnología. Ya sea que busques actualizar tu estación de trabajo o armar la PC Gamer de tus sueños, tenemos el inventario y la experiencia para ayudarte.
                </p>
            </div>
        </div>

    </div>

</section>

<!-- Call To Action Section -->
<section id="call-to-action" class="call-to-action section dark-background">

    <img src="~/assets/img/cta-bg.jpg" alt="">

    <div class="container">
        <div class="row justify-content-center" data-aos="zoom-in" data-aos-delay="100">
            <div class="col-xl-10">
                <div class="text-center">
                    <h3>¿Listo para actualizar?</h3>
                    <p>Explora nuestro catálogo completo y encuentra las mejores ofertas de la temporada.</p>
                    <a class="cta-btn" asp-controller="Productos" asp-action="Index">Ver Productos</a>
                </div>
            </div>
        </div>
    </div>

</section>

<!-- Services Section -->
<section id="services" class="services section">

    <div class="container section-title" data-aos="fade-up">
        <h2>Servicios</h2>
        <p>¿Qué ofrecemos?</p>
    </div>

    <div class="container">

        <div class="row gy-4">

            <div class="col-lg-4 col-md-6" data-aos="fade-up" data-aos-delay="100">
                <div class="service-item position-relative">
                    <div class="icon">
                        <i class="bi bi-cart4"></i>
                    </div>
                    <h3>Venta de Hardware</h3>
                    <p>Componentes de última generación de las marcas más reconocidas: Intel, AMD, NVIDIA, Asus, MSI.</p>
                </div>
            </div>

            <div class="col-lg-4 col-md-6" data-aos="fade-up" data-aos-delay="200">
                <div class="service-item position-relative">
                    <div class="icon">
                        <i class="bi bi-tools"></i>
                    </div>
                    <h3>Soporte Técnico</h3>
                    <p>Diagnóstico, reparación y mantenimiento preventivo de equipos de computación.</p>
                </div>
            </div>

            <div class="col-lg-4 col-md-6" data-aos="fade-up" data-aos-delay="300">
                <div class="service-item position-relative">
                    <div class="icon">
                        <i class="bi bi-pc-display"></i>
                    </div>
                    <h3>Armado de PCs</h3>
                    <p>Ensamblaje profesional de equipos Gamer, Workstations y PCs de oficina con gestión de cables premium.</p>
                </div>
            </div>

        </div>

    </div>

</section>

<!-- Contact Section -->
<section id="contact" class="contact section">

    <div class="container section-title" data-aos="fade-up">
        <h2>Contacto</h2>
        <p>Visítanos</p>
    </div>

    <div class="container" data-aos="fade-up" data-aos-delay="100">

        <div class="mb-4" data-aos="fade-up" data-aos-delay="200">
            <iframe style="border:0; width: 100%; height: 270px;" src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3762.5!2d-65.2!3d-19.0!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x0%3A0x0!2zMTnCsDAwJzAwLjAiUyA2NcKwMTInMDAuMCJX!5e0!3m2!1ses!2sbo!4v1600000000000!5m2!1ses!2sbo" frameborder="0" allowfullscreen="" loading="lazy" referrerpolicy="no-referrer-when-downgrade"></iframe>
        </div>

        <div class="row gy-4">

            <div class="col-lg-4">
                <div class="info-item d-flex" data-aos="fade-up" data-aos-delay="300">
                    <i class="bi bi-geo-alt flex-shrink-0"></i>
                    <div>
                        <h3>Dirección</h3>
                        <p>Av. Tecnológica #123, Sucre</p>
                    </div>
                </div>

                <div class="info-item d-flex" data-aos="fade-up" data-aos-delay="400">
                    <i class="bi bi-telephone flex-shrink-0"></i>
                    <div>
                        <h3>Llámanos</h3>
                        <p>+591 4 645-1234</p>
                    </div>
                </div>

                <div class="info-item d-flex" data-aos="fade-up" data-aos-delay="500">
                    <i class="bi bi-envelope flex-shrink-0"></i>
                    <div>
                        <h3>Email</h3>
                        <p>info@chipset.bo</p>
                    </div>
                </div>
            </div>

            <div class="col-lg-8">
                <form action="#" method="post" class="php-email-form" data-aos="fade-up" data-aos-delay="200">
                    <div class="row gy-4">
                        <div class="col-md-6">
                            <input type="text" name="name" class="form-control" placeholder="Tu Nombre" required="">
                        </div>
                        <div class="col-md-6 ">
                            <input type="email" class="form-control" name="email" placeholder="Tu Email" required="">
                        </div>
                        <div class="col-md-12">
                            <input type="text" class="form-control" name="subject" placeholder="Asunto" required="">
                        </div>
                        <div class="col-md-12">
                            <textarea class="form-control" name="message" rows="6" placeholder="Mensaje" required=""></textarea>
                        </div>
                        <div class="col-md-12 text-center">
                            <button type="submit">Enviar Mensaje</button>
                        </div>
                    </div>
                </form>
            </div>

        </div>

    </div>

</section>