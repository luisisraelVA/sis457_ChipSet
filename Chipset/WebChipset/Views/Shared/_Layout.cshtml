<!DOCTYPE html>
<html lang="es">

<head>
    <meta charset="utf-8">
    <meta content="width=device-width, initial-scale=1.0" name="viewport">
    <title>@ViewData["Title"] - ChipSet</title>
    <meta content="Sistema de Gestión de Hardware" name="description">
    <meta content="pc, hardware, ventas" name="keywords">

    <link href="~/assets/img/favicon.png" rel="icon">
    <link href="~/assets/img/apple-touch-icon.png" rel="apple-touch-icon">

    <link href="https://fonts.googleapis.com" rel="preconnect">
    <link href="https://fonts.gstatic.com" rel="preconnect" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Roboto:wght@100;300;400;500;700;900&family=Poppins:wght@100;200;300;400;500;600;700;800;900&display=swap" rel="stylesheet">

    <link href="~/assets/vendor/bootstrap/css/bootstrap.min.css" rel="stylesheet">
    <link href="~/assets/vendor/bootstrap-icons/bootstrap-icons.css" rel="stylesheet">
    <link href="~/assets/vendor/aos/aos.css" rel="stylesheet">
    <link href="~/assets/vendor/swiper/swiper-bundle.min.css" rel="stylesheet">
    <link href="~/assets/vendor/glightbox/css/glightbox.min.css" rel="stylesheet">

    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />

    <link href="~/assets/css/main.css" rel="stylesheet">

    <link rel="stylesheet" href="~/WebChipset.styles.css" asp-append-version="true" />

    <style>
        /* 1. Fondo blanco para toda la página */
        body {
            background-color: #ffffff !important;
        }

        /* 2. Empujar el contenido hacia abajo (para que no lo tape el menú) */
        main {
            margin-top: 100px !important;
            min-height: 80vh; /* Empuja el footer hacia el final */
            padding-bottom: 50px;
        }

        /* 3. CAMBIAR EL FOOTER DE NEGRO A BLANCO */
        #footer {
            background-color: #f8f9fa !important; /* Gris muy claro (casi blanco) */
            color: #343a40 !important; /* Texto oscuro */
            border-top: 1px solid #dee2e6; /* Línea superior sutil */
        }

            /* 4. Arreglar el color de los textos del footer (para que se vean sobre fondo claro) */
            #footer a,
            #footer h4,
            #footer strong,
            #footer .sitename,
            #footer p {
                color: #343a40 !important; /* Texto negro/gris oscuro */
            }

            #footer .copyright {
                color: #6c757d !important; /* Gris medio */
                border-top: 1px solid #dee2e6;
            }

            /* Iconos de redes sociales */
            #footer .social-links a {
                background-color: #ffffff !important;
                border: 1px solid #ced4da;
                color: #343a40 !important;
            }
    </style>
</head>

<body class="starter-page-page">

    <header id="header" class="header d-flex align-items-center fixed-top">
        <div class="container-fluid container-xl position-relative d-flex align-items-center justify-content-between">

            <a asp-controller="Home" asp-action="Index" class="logo d-flex align-items-center me-auto me-lg-0">
                <h1 class="sitename">ChipSet</h1>
                <span>.</span>
            </a>

            <nav id="navmenu" class="navmenu">
                <ul>
                    <li><a asp-controller="Home" asp-action="Index" class="active">Inicio<br></a></li>

                    <li class="dropdown">
                        <a href="#"><span>Gestión</span> <i class="bi bi-chevron-down toggle-dropdown"></i></a>
                        <ul>
                            <li><a asp-controller="Productos" asp-action="Index">Inventario de Productos</a></li>
                            <li><a asp-controller="Clientes" asp-action="Index">Cartera de Clientes</a></li>
                            <li><a asp-controller="Proveedores" asp-action="Index">Proveedores</a></li>
                            <li class="dropdown">
                                <a href="#"><span>Configuración</span> <i class="bi bi-chevron-down toggle-dropdown"></i></a>
                                <ul>
                                    <li><a asp-controller="Categorias" asp-action="Index">Categorías</a></li>
                                    <li><a asp-controller="Roles" asp-action="Index">Roles</a></li>
                                </ul>
                            </li>
                        </ul>
                    </li>

                    <li><a asp-controller="Pedidoes" asp-action="Index">Historial Ventas</a></li>
                    <li><a href="#contact">Contacto</a></li>
                </ul>
                <i class="mobile-nav-toggle d-xl-none bi bi-list"></i>
            </nav>

        </div>
    </header>

    <main class="main">
        @RenderBody()
    </main>



    <a href="#" id="scroll-top" class="scroll-top d-flex align-items-center justify-content-center"><i class="bi bi-arrow-up-short"></i></a>

    <div id="preloader"></div>

    <script src="~/assets/vendor/bootstrap/js/bootstrap.bundle.min.js"></script>
    <script src="~/assets/vendor/php-email-form/validate.js"></script>
    <script src="~/assets/vendor/aos/aos.js"></script>
    <script src="~/assets/vendor/swiper/swiper-bundle.min.js"></script>
    <script src="~/assets/vendor/glightbox/js/glightbox.min.js"></script>
    <script src="~/assets/vendor/imagesloaded/imagesloaded.pkgd.min.js"></script>
    <script src="~/assets/vendor/isotope-layout/isotope.pkgd.min.js"></script>
    <script src="~/assets/vendor/purecounter/purecounter_vanilla.js"></script>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>

    <script src="~/assets/js/main.js"></script>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>