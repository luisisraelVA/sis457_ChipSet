@model IEnumerable<WebChipset.Models.Cliente>

@{
    ViewData["Title"] = "Cartera de Clientes";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-4">

    <div class="card shadow border-0">

        <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center py-3">
            <h4 class="mb-0 fw-bold">
                <i class="fas fa-users me-2"></i>Cartera de Clientes
            </h4>
            <a asp-action="Create" class="btn btn-light text-primary fw-bold">
                <i class="fas fa-user-plus me-1"></i> Nuevo Cliente
            </a>
        </div>

        <div class="card-body bg-light">

            <form asp-action="Index" method="get" class="mb-4">
                <div class="input-group shadow-sm">
                    <span class="input-group-text bg-white border-end-0"><i class="fas fa-search text-muted"></i></span>
                    <input type="text" name="buscar" class="form-control border-start-0 ps-0" placeholder="Buscar por nombre, email o teléfono...">
                    <button class="btn btn-primary px-4" type="submit">Buscar</button>
                    <a asp-action="Index" class="btn btn-secondary px-3" title="Recargar"><i class="fas fa-sync-alt"></i></a>
                </div>
            </form>

            <div class="table-responsive bg-white rounded shadow-sm">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr class="text-secondary">
                            <th class="ps-4">Cliente</th>
                            <th>Información de Contacto</th>
                            <th class="text-center">Estado</th>
                            <th class="text-end pe-4">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td class="ps-4">
                                    <div class="d-flex align-items-center">
                                        <div class="bg-light text-primary rounded-circle p-2 me-3 d-flex justify-content-center align-items-center" style="width: 45px; height: 45px;">
                                            <i class="fas fa-user fa-lg"></i>
                                        </div>
                                        <div>
                                            <h6 class="mb-0 fw-bold text-dark">@item.Nombre</h6>
                                            <small class="text-muted">ID: #@item.Id</small>
                                        </div>
                                    </div>
                                </td>

                                <td>
                                    <div class="d-flex flex-column">
                                        <span class="mb-1">
                                            <i class="fas fa-envelope text-secondary me-2"></i>@item.Email
                                        </span>
                                        @if (!string.IsNullOrEmpty(item.Telefono))
                                        {
                                            <small class="text-muted">
                                                <i class="fas fa-phone text-secondary me-2"></i>@item.Telefono
                                            </small>
                                        }
                                        else
                                        {
                                            <small class="text-muted fst-italic">Sin teléfono</small>
                                        }
                                    </div>
                                </td>

                                <td class="text-center">
                                    @if (item.Estado == 1)
                                    {
                                        <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill px-3">
                                            <i class="fas fa-check-circle me-1"></i> Activo
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger-subtle text-danger border border-danger-subtle rounded-pill px-3">
                                            <i class="fas fa-ban me-1"></i> Inactivo
                                        </span>
                                    }
                                </td>

                                <td class="text-end pe-4">
                                    <div class="btn-group shadow-sm" role="group">
                                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-outline-warning btn-sm" title="Editar">
                                            <i class="fas fa-pen"></i>
                                        </a>
                                        <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-outline-info btn-sm" title="Detalles">
                                            <i class="fas fa-eye"></i>
                                        </a>
                                        <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-outline-danger btn-sm" title="Eliminar">
                                            <i class="fas fa-trash"></i>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            @if (!Model.Any())
            {
                <div class="text-center py-5">
                    <i class="fas fa-users-slash fa-3x text-muted mb-3"></i>
                    <h5 class="text-muted">No se encontraron clientes</h5>
                </div>
            }
        </div>
    </div>
</div>