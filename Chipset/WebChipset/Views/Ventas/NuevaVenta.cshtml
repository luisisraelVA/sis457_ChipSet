@{
    ViewData["Title"] = "Nueva Venta";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" />
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/select2-bootstrap-5-theme@1.3.0/dist/select2-bootstrap-5-theme.min.css" />
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />

<div class="container mt-4">
    <div class="card shadow">
        <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
            <h3 class="mb-0"><i class="fas fa-shopping-cart me-2"></i>Punto de Venta</h3>
            <span class="badge bg-light text-primary fs-6">@DateTime.Now.ToString("dd/MM/yyyy")</span>
        </div>
        <div class="card-body">

            <div class="row mb-4">
                <div class="col-md-12">
                    <label class="form-label fw-bold"><i class="fas fa-user me-1"></i> Cliente:</label>
                    <div class="input-group">
                        <select id="selectCliente" class="form-select form-select-lg" asp-items="ViewBag.IdCliente">
                            <option value="">-- Seleccione un Cliente --</option>
                        </select>
                        <button class="btn btn-success" type="button" data-bs-toggle="modal" data-bs-target="#modalNuevoCliente">
                            <i class="fas fa-plus"></i> Nuevo
                        </button>
                    </div>
                </div>
            </div>

            <div class="card bg-light border-0 mb-3">
                <div class="card-body">
                    <div class="row align-items-end">
                        <div class="col-md-5">
                            <label class="form-label fw-bold">Producto:</label>
                            <select id="selectProducto" class="form-select" asp-items="ViewBag.ListaProductos">
                                <option value="">-- Seleccione un Producto --</option>
                            </select>
                            <small class="text-muted" id="lblStock">Stock disponible: -</small>
                        </div>
                        <div class="col-md-2">
                            <label class="form-label fw-bold">Precio:</label>
                            <div class="input-group">
                                <span class="input-group-text">$</span>
                                <input type="text" id="txtPrecio" class="form-control bg-white" readonly />
                            </div>
                        </div>
                        <div class="col-md-2">
                            <label class="form-label fw-bold">Cantidad:</label>
                            <input type="number" id="txtCantidad" class="form-control" value="1" min="1" />
                        </div>
                        <div class="col-md-3 d-grid">
                            <button class="btn btn-success fw-bold" id="btnAgregar" type="button">
                                <i class="fas fa-plus-circle"></i> AGREGAR
                            </button>
                        </div>
                    </div>
                </div>
            </div>

            <div class="table-responsive">
                <table class="table table-striped table-bordered align-middle" id="tablaCarrito">
                    <thead class="table-dark text-center">
                        <tr>
                            <th>Producto</th>
                            <th style="width: 100px;">Cant.</th>
                            <th style="width: 150px;">Precio Unit.</th>
                            <th style="width: 150px;">Subtotal</th>
                            <th style="width: 80px;"></th>
                        </tr>
                    </thead>
                    <tbody></tbody>
                    <tfoot>
                        <tr>
                            <td colspan="3" class="text-end fw-bold fs-4">TOTAL A PAGAR:</td>
                            <td class="text-end fw-bold fs-4 text-success" id="lblTotal">$ 0.00</td>
                            <td></td>
                        </tr>
                    </tfoot>
                </table>
            </div>
        </div>
        <div class="card-footer text-end py-3">
            <a asp-controller="Home" asp-action="Index" class="btn btn-secondary me-2">Cancelar</a>
            <button class="btn btn-primary btn-lg fw-bold px-5" id="btnTerminarVenta">
                <i class="fas fa-save me-2"></i> TERMINAR VENTA
            </button>
        </div>
    </div>
</div>

<div class="modal fade" id="modalNuevoCliente" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header bg-success text-white">
                <h5 class="modal-title"><i class="fas fa-user-plus me-2"></i>Registrar Cliente Rápido</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <form id="formClienteRapido">
                    <div class="mb-3">
                        <label class="form-label fw-bold">Nombre Completo</label>
                        <input type="text" class="form-control" id="cliNombre" required placeholder="Ej: Juan Perez">
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold">Email</label>
                        <input type="email" class="form-control" id="cliEmail" required placeholder="juan@email.com">
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold">Teléfono</label>
                        <input type="text" class="form-control" id="cliTelefono" placeholder="Ej: 77712345">
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                <button type="button" class="btn btn-success" id="btnGuardarCliente">Guardar y Seleccionar</button>
            </div>
        </div>
    </div>
</div>

<script id="jsonProductosData" type="application/json">
    @Html.Raw(Json.Serialize(ViewBag.DatosProductos))
</script>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>
    <script>

        let listaProductos = [];
        const scriptData = document.getElementById("jsonProductosData");
        if (scriptData && scriptData.textContent) {
            listaProductos = JSON.parse(scriptData.textContent);
        }

        let totalVenta = 0.0;
        let detallesVenta = [];

        $(document).ready(function() {

            $('#selectProducto').select2({
                theme: 'bootstrap-5',      
                width: '100%',             
                placeholder: "Buscar un producto...", 
                allowClear: true           
            });
            $('#selectProducto').change(function() {
                const valSeleccionado = $(this).val();
                if (!valSeleccionado) { limpiarCamposProducto(); return; }
                const idSeleccionado = parseInt(valSeleccionado);
                const producto = listaProductos.find(p => (p.id || p.Id) === idSeleccionado);
                if (producto) {
                    const precio = producto.precioVenta || producto.PrecioVenta;
                    const stock = producto.stock || producto.Stock;
                    $('#txtPrecio').val(precio.toFixed(2));
                    $('#lblStock').text("Stock disponible: " + stock).removeClass("text-danger");
                    $('#txtCantidad').attr('max', stock).val(1);
                }
            });

            $('#btnAgregar').click(function() {

                const valSeleccionado = $('#selectProducto').val();
                if (!valSeleccionado) { Swal.fire('Atención', 'Seleccione un producto.', 'warning'); return; }
                const idProducto = parseInt(valSeleccionado);
                const nombreProducto = $("#selectProducto option:selected").text().split(" - ")[0];
                const cantidad = parseInt($('#txtCantidad').val());
                const precio = parseFloat($('#txtPrecio').val());

                if (isNaN(cantidad) || cantidad < 1) { Swal.fire('Atención', 'Cantidad inválida.', 'warning'); return; }

                const productoInfo = listaProductos.find(p => (p.id || p.Id) === idProducto);
                const stockReal = productoInfo.stock || productoInfo.Stock;
                if (cantidad > stockReal) { Swal.fire('Stock', 'No hay suficiente stock.', 'error'); return; }

                if (detallesVenta.some(x => x.IdProducto === idProducto)) { Swal.fire('Atención', 'Producto ya agregado.', 'warning'); return; }

                const subtotal = cantidad * precio;
                const fila = `<tr id="fila-${idProducto}"><td>${nombreProducto}</td><td class="text-center fw-bold">${cantidad}</td><td class="text-end">$ ${precio.toFixed(2)}</td><td class="text-end fw-bold">$ ${subtotal.toFixed(2)}</td><td class="text-center"><button class="btn btn-outline-danger btn-sm btn-eliminar" data-id="${idProducto}" data-subtotal="${subtotal}"><i class="fas fa-trash"></i></button></td></tr>`;

                $('#tablaCarrito tbody').append(fila);
                detallesVenta.push({ IdProducto: idProducto, Cantidad: cantidad, PrecioUnitario: precio });
                actualizarTotal(subtotal);
                limpiarCamposProducto();
            });

            $(document).on('click', '.btn-eliminar', function() {
                const id = $(this).data('id');
                const subtotal = parseFloat($(this).data('subtotal'));
                detallesVenta = detallesVenta.filter(p => p.IdProducto !== id);
                $(`#fila-${id}`).remove();
                actualizarTotal(-subtotal);
            });

            $('#btnTerminarVenta').click(function() {
                const idCliente = $('#selectCliente').val();
                if (!idCliente) { Swal.fire('Falta Cliente', 'Seleccione un cliente.', 'warning'); return; }
                if (detallesVenta.length === 0) { Swal.fire('Carrito Vacío', 'Agregue productos.', 'warning'); return; }

                const ventaModelo = { IdCliente: parseInt(idCliente), Total: totalVenta, Detalles: detallesVenta };

                Swal.fire({ title: 'Procesando...', didOpen: () => { Swal.showLoading() } });

                $.ajax({
                    url: '@Url.Action("GuardarVenta", "Ventas")',
                    type: 'POST', contentType: 'application/json', data: JSON.stringify(ventaModelo),
                    success: function(resp) {
                        if (resp.success) {
                            Swal.fire('Éxito', 'Venta registrada.', 'success').then(() => { window.location.href = '@Url.Action("Index", "Pedidoes")'; });
                        } else { Swal.fire('Error', resp.message, 'error'); }
                    },
                    error: function() { Swal.fire('Error', 'Fallo en el servidor.', 'error'); }
                });
            });

            function actualizarTotal(monto) { totalVenta += monto; totalVenta = parseFloat(totalVenta.toFixed(2)); $('#lblTotal').text("$ " + totalVenta.toFixed(2)); }
            function limpiarCamposProducto() { $('#selectProducto').val(""); $('#txtCantidad').val(1); $('#txtPrecio').val(""); $('#lblStock').text("Stock disponible: -"); }


            $('#btnGuardarCliente').click(function() {
                const nombre = $('#cliNombre').val();
                const email = $('#cliEmail').val();
                const telefono = $('#cliTelefono').val();

                if (!nombre || !email) {
                    Swal.fire('Faltan datos', 'El nombre y el email son obligatorios.', 'warning');
                    return;
                }

                const nuevoCliente = { Nombre: nombre, Email: email, Telefono: telefono };

                $.ajax({
                    url: '/Clientes/CrearRapido',
                    type: 'POST',
                    contentType: 'application/json',
                    data: JSON.stringify(nuevoCliente),
                    success: function(response) {
                        if (response.success) {

                            const nuevaOpcion = `<option value="${response.data.id}" selected>${response.data.nombre}</option>`;
                            $('#selectCliente').append(nuevaOpcion);

                            $('#modalNuevoCliente').modal('hide');
                            $('#formClienteRapido')[0].reset();

                            Swal.fire('Listo', 'Cliente creado y seleccionado.', 'success');
                        } else {
                            Swal.fire('Error', response.message, 'error');
                        }
                    },
                    error: function() {
                        Swal.fire('Error', 'No se pudo registrar el cliente.', 'error');
                    }
                });
            });
        });
    </script>
}