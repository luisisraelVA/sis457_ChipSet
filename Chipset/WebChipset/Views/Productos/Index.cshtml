@model IEnumerable<WebChipset.Models.Producto>

@{
    ViewData["Title"] = "Inventario de Productos";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-4">

    <div class="card shadow border-0">

        <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center py-3">
            <h4 class="mb-0 fw-bold">
                <i class="fas fa-box-open me-2"></i>Inventario
            </h4>

            <a asp-action="Create" class="btn btn-light text-primary fw-bold">
                <i class="fas fa-plus me-1"></i> Nuevo Producto
            </a>
        </div>

        <div class="card-body bg-light">

            <form asp-action="Index" method="get" class="mb-4">
                <div class="input-group shadow-sm">
                    <span class="input-group-text bg-white border-end-0"><i class="fas fa-search text-muted"></i></span>
                    <input type="text" name="buscar" value="@ViewData["BusquedaActual"]" class="form-control border-start-0 ps-0" placeholder="Buscar por nombre, categoría o proveedor...">
                    <button class="btn btn-primary px-4" type="submit">Buscar</button>
                    <a asp-action="Index" class="btn btn-secondary px-3" title="Limpiar filtro"><i class="fas fa-sync-alt"></i></a>
                </div>
            </form>

            <div class="table-responsive bg-white rounded shadow-sm">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr class="text-secondary">
                            <th class="ps-4">Producto / Descripción</th>
                            <th>Categoría / Prov.</th>
                            <th class="text-center">Precio</th>
                            <th class="text-center">Stock</th>
                            <th class="text-center">Estado</th>
                            <th class="text-end pe-4">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td class="ps-4">
                                    <div class="d-flex align-items-center">
                                        <div class="avatar-icon bg-light text-primary rounded-circle p-2 me-3 d-none d-md-block">
                                            <i class="fas fa-microchip fa-lg"></i>
                                        </div>
                                        <div>
                                            <h6 class="mb-0 fw-bold text-dark">@item.Nombre</h6>
                                            <small class="text-muted d-block text-truncate" style="max-width: 250px;">
                                                @item.Descripcion
                                            </small>
                                        </div>
                                    </div>
                                </td>
                                <td>
                                    <span class="badge bg-light text-dark border border-secondary-subtle mb-1">
                                        <i class="fas fa-tag me-1"></i> @item.IdCategoriaNavigation.Nombre
                                    </span>
                                    <br />
                                    <small class="text-muted"><i class="fas fa-truck me-1"></i> @item.IdProveedorNavigation.Nombre</small>
                                </td>
                                <td class="text-center fw-bold text-success fs-5">
                                    @item.PrecioVenta.ToString("C2")
                                </td>
                                <td class="text-center">
                                    @if (item.Stock < 10)
                                    {
                                        <span class="badge bg-danger rounded-pill">@item.Stock un.</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-primary rounded-pill">@item.Stock un.</span>
                                    }
                                </td>
                                <td class="text-center">
                                    @if (item.Estado == 1)
                                    {
                                        <span class="text-success small fw-bold"><i class="fas fa-check-circle"></i> Activo</span>
                                    }
                                    else
                                    {
                                        <span class="text-danger small fw-bold"><i class="fas fa-times-circle"></i> Inactivo</span>
                                    }
                                </td>
                                <td class="text-end pe-4">
                                    <div class="btn-group" role="group">
                                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-outline-warning btn-sm" title="Editar">
                                            <i class="fas fa-pen"></i>
                                        </a>
                                        <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-outline-info btn-sm" title="Detalles">
                                            <i class="fas fa-eye"></i>
                                        </a>
                                        <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-outline-danger btn-sm" title="Eliminar">
                                            <i class="fas fa-trash"></i>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            @if (!Model.Any())
            {
                <div class="text-center py-5">
                    <i class="fas fa-box-open fa-3x text-muted mb-3"></i>
                    <h5 class="text-muted">No se encontraron productos</h5>
                </div>
            }
        </div>
    </div>
</div>