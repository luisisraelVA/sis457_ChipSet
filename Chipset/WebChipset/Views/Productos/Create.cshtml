@model WebChipset.Models.Producto

@{
    ViewData["Title"] = "Crear Producto";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />

<h1>Create</h1>

<h4>Producto</h4>
<hr />
<div class="container mt-4">
    <div class="card shadow-sm">
        <div class="card-header bg-primary text-white">
            <h4 class="mb-0"><i class="fa-solid fa-box-open"></i> Nuevo Producto</h4>
        </div>
        <div class="card-body">
            <form asp-action="Create">
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                <div class="mb-3">
                    <label asp-for="Nombre" class="form-label fw-bold"></label>
                    <input asp-for="Nombre" class="form-control" placeholder="Ingrese el nombre del producto" />
                    <span asp-validation-for="Nombre" class="text-danger"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="Descripcion" class="form-label fw-bold"></label>
                    <textarea asp-for="Descripcion" class="form-control" rows="2" placeholder="Descripción breve..."></textarea>
                    <span asp-validation-for="Descripcion" class="text-danger"></span>
                </div>
                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label class="form-label fw-bold">Categoría</label>
                        <select asp-for="IdCategoria" class="form-select form-control" asp-items="ViewBag.ListaCategorias">
                            <option value="">-- Seleccione una Categoria --</option>
                        </select>
                    </div>
                    <div class="col-md-6 mb-3">
                        <label asp-for="IdProveedor" class="form-label fw-bold">Proveedor</label>
                        <select asp-for="IdProveedor" class="form-select form-control" asp-items="ViewBag.ListaProveedores">
                            <option value="">-- Seleccione un Proveedor --</option>
                        </select>
                    </div>
                </div>
                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label asp-for="PrecioVenta" class="form-label fw-bold"></label>
                        <div class="input-group">
                            <span class="input-group-text">$</span>
                            <input asp-for="PrecioVenta" class="form-control" type="number" step="0.01" />
                        </div>
                        <span asp-validation-for="PrecioVenta" class="text-danger"></span>
                    </div>
                    <div class="col-md-6 mb-3">
                        <label asp-for="Stock" class="form-label fw-bold"></label>
                        <input asp-for="Stock" class="form-control" type="number" />
                        <span asp-validation-for="Stock" class="text-danger"></span>
                    </div>
                </div>
                <hr />
                <div class="d-flex justify-content-between">
                    <a asp-action="Index" class="btn btn-secondary">
                        <i class="fa-solid fa-arrow-left"></i> Volver a la Lista
                    </a>
                    <button type="submit" class="btn btn-success">
                        <i class="fa-solid fa-floppy-disk"></i> Guardar Producto
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
