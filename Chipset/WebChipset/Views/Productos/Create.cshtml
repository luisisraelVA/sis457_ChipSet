@model WebChipset.Models.Producto

@{
    ViewData["Title"] = "Nuevo Producto";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card shadow-lg border-0 rounded-3">

                <div class="card-header bg-primary text-white py-3">
                    <h4 class="mb-0 fw-bold">
                        <i class="fas fa-plus-circle me-2"></i>Registrar Nuevo Producto
                    </h4>
                </div>

                <div class="card-body p-4 bg-light">
                    <form asp-action="Create">
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                        <div class="mb-4">
                            <label asp-for="Nombre" class="form-label fw-bold text-secondary">Nombre del Producto</label>
                            <div class="input-group">
                                <span class="input-group-text bg-white"><i class="fas fa-box text-primary"></i></span>
                                <input asp-for="Nombre" class="form-control" placeholder="Ej: Tarjeta Gráfica RTX 3060" />
                            </div>
                            <span asp-validation-for="Nombre" class="text-danger small"></span>
                        </div>

                        <div class="row mb-4">
                            <div class="col-md-6">
                                <label asp-for="IdCategoria" class="form-label fw-bold text-secondary">Categoría</label>
                                <div class="input-group">
                                    <span class="input-group-text bg-white"><i class="fas fa-tags text-primary"></i></span>
                                    <select asp-for="IdCategoria" class="form-select" asp-items="ViewBag.ListaCategorias">
                                        <option value="">-- Seleccione --</option>
                                    </select>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="IdProveedor" class="form-label fw-bold text-secondary">Proveedor</label>
                                <div class="input-group">
                                    <span class="input-group-text bg-white"><i class="fas fa-truck text-primary"></i></span>
                                    <select asp-for="IdProveedor" class="form-select" asp-items="ViewBag.ListaProveedores">
                                        <option value="">-- Seleccione --</option>
                                    </select>
                                </div>
                            </div>
                        </div>

                        <div class="row mb-4">
                            <div class="col-md-6">
                                <label asp-for="PrecioVenta" class="form-label fw-bold text-secondary">Precio de Venta</label>
                                <div class="input-group">
                                    <span class="input-group-text bg-white fw-bold text-success">$</span>
                                    <input asp-for="PrecioVenta" class="form-control" placeholder="0.00" type="number" step="0.01" />
                                </div>
                                <span asp-validation-for="PrecioVenta" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="Stock" class="form-label fw-bold text-secondary">Stock Inicial</label>
                                <div class="input-group">
                                    <span class="input-group-text bg-white"><i class="fas fa-cubes text-primary"></i></span>
                                    <input asp-for="Stock" class="form-control" placeholder="0" type="number" />
                                </div>
                                <span asp-validation-for="Stock" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="mb-4">
                            <label asp-for="Descripcion" class="form-label fw-bold text-secondary">Descripción</label>
                            <textarea asp-for="Descripcion" class="form-control" rows="3" placeholder="Detalles técnicos del producto..."></textarea>
                            <span asp-validation-for="Descripcion" class="text-danger small"></span>
                        </div>

                        <div class="d-flex justify-content-between pt-2">
                            <a asp-action="Index" class="btn btn-outline-secondary px-4">
                                <i class="fas fa-arrow-left me-2"></i>Cancelar
                            </a>
                            <button type="submit" class="btn btn-primary px-5 fw-bold shadow-sm">
                                <i class="fas fa-save me-2"></i> Guardar Producto
                            </button>
                        </div>

                    </form>
                </div>
            </div>

        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}