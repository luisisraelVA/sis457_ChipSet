@model WebChipset.Models.Producto

@{
    ViewData["Title"] = "Eliminar Producto";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
<div class="container mt-4">
    <div class="card shadow-sm border-danger">
        <div class="card-header bg-danger text-white">
            <h4 class="mb-0">
                <i class="fa-solid fa-triangle-exclamation"></i> ¿Está seguro de que desea eliminar este producto?
            </h4>
        </div>
        <div class="card-body">
            <div class="alert alert-warning" role="alert">
                <i class="fa-solid fa-circle-exclamation"></i> Esta acción no se puede deshacer. Verifique los datos antes de continuar.
            </div>
            <dl class="row">
                <dt class="col-sm-3">
                    @Html.DisplayNameFor(model => model.Nombre)
                </dt>
                <dd class="col-sm-9 fw-bold fs-5">
                    @Html.DisplayFor(model => model.Nombre)
                </dd>
                <dt class="col-sm-3">
                    @Html.DisplayNameFor(model => model.Descripcion)
                </dt>
                <dd class="col-sm-9">
                    @Html.DisplayFor(model => model.Descripcion)
                </dd>
                <hr class="my-2" />
                <dt class="col-sm-3">
                    Categoria
                </dt>
                <dd class="col-sm-9">
                    @Html.DisplayFor(model => model.IdCategoriaNavigation.Nombre)
                </dd>
                <dt class="col-sm-3">
                    Proveedor
                </dt>
                <dd class="col-sm-9">
                    @Html.DisplayFor(model => model.IdProveedorNavigation.Nombre)
                </dd>
                <hr class="my-2" />
                <dt class="col-sm-3">
                    @Html.DisplayNameFor(model => model.PrecioVenta)
                </dt>
                <dd class="col-sm-9">
                    @Html.DisplayFor(model => model.PrecioVenta)
                </dd>
                <dt class="col-sm-3">
                    @Html.DisplayNameFor(model => model.Stock)
                </dt>
                <dd class="col-sm-9">
                    @Html.DisplayFor(model => model.Stock)
                </dd>
                <dt class="col-sm-3">
                    @Html.DisplayNameFor(model => model.Estado)
                </dt>
                <dd class="col-sm-9">
                    @if (Model.Estado == 1)
                    {
                        <span class="badge bg-success">Activo</span>
                    }
                    else
                    {
                        <span class="badge bg-danger">Inactivo</span>
                    }
                </dd>
            </dl>
        </div>
        <div class="card-footer">
            <form asp-action="Delete" class="d-flex justify-content-between">
                <input type="hidden" asp-for="Id" />
                <a asp-action="Index" class="btn btn-secondary">
                    <i class="fa-solid fa-arrow-left"></i> Cancelar / Volver
                </a>
                <button type="submit" class="btn btn-danger">
                    <i class="fa-solid fa-trash-can"></i> Confirmar Eliminación
                </button>
            </form>
        </div>
    </div>

</div>