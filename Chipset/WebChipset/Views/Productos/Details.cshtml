@model WebChipset.Models.Producto

@{
    ViewData["Title"] = "Detalles del Producto";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />

<div class="container mt-4">
    <div class="card shadow-sm">
        <div class="card-header bg-info text-white">
            <h4 class="mb-0"><i class="fa-solid fa-circle-info"></i> Detalles del Producto</h4>
        </div>
        <div class="card-body">
            <dl class="row">
                <dt class="col-sm-3">
                    @Html.DisplayNameFor(model => model.Nombre)
                </dt>
                <dd class="col-sm-9 fw-bold">
                    @Html.DisplayFor(model => model.Nombre)
                </dd>
                <dt class="col-sm-3">
                    @Html.DisplayNameFor(model => model.Descripcion)
                </dt>
                <dd class="col-sm-9">
                    @Html.DisplayFor(model => model.Descripcion)
                </dd>
                <hr class="my-3" />
                <dt class="col-sm-3">
                    Categoria
                </dt>
                <dd class="col-sm-9">
                    @Html.DisplayFor(model => model.IdCategoriaNavigation.Nombre)
                </dd>
                <dt class="col-sm-3">
                    Proveedor
                </dt>
                <dd class="col-sm-9">
                    @Html.DisplayFor(model => model.IdProveedorNavigation.Nombre)
                </dd>
                <hr class="my-3" />
                <dt class="col-sm-3">
                    @Html.DisplayNameFor(model => model.PrecioVenta)
                </dt>
                <dd class="col-sm-9 text-success fw-bold">
                    $@Html.DisplayFor(model => model.PrecioVenta)
                </dd>
                <dt class="col-sm-3">
                    @Html.DisplayNameFor(model => model.Stock)
                </dt>
                <dd class="col-sm-9">
                    @Html.DisplayFor(model => model.Stock) unidades
                </dd>
                <dt class="col-sm-3">
                    @Html.DisplayNameFor(model => model.Estado)
                </dt>
                <dd class="col-sm-9">
                    @if (Model.Estado == 1)
                    {
                        <span class="badge bg-success">Activo</span>
                    }
                    else
                    {
                        <span class="badge bg-danger">Inactivo</span>
                    }
                </dd>
                <hr class="my-3" />
                <dt class="col-sm-3 text-muted small">
                    Registrado por
                </dt>
                <dd class="col-sm-9 text-muted small">
                    @Html.DisplayFor(model => model.UsuarioRegistro)
                </dd>
                <dt class="col-sm-3 text-muted small">
                    Fecha Registro
                </dt>
                <dd class="col-sm-9 text-muted small">
                    @Html.DisplayFor(model => model.FechaRegistro)
                </dd>
            </dl>
        </div>
        <div class="card-footer d-flex justify-content-between">
            <a asp-action="Index" class="btn btn-secondary">
                <i class="fa-solid fa-arrow-left"></i> Volver a la Lista
            </a>
            <a asp-action="Edit" asp-route-id="@Model?.Id" class="btn btn-warning">
                <i class="fa-solid fa-pen-to-square"></i> Editar Producto
            </a> |
        </div>
    </div>
</div>
