@model WebChipset.Models.Pedido

@{
    ViewData["Title"] = "Detalles del Pedido";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />

<div class="container mt-4">
    <div class="card shadow-sm">
        <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
            <h3 class="mb-0"><i class="fas fa-file-invoice-dollar me-2"></i>Detalles del Pedido #@Model.Id</h3>
            <a asp-action="Index" class="btn btn-light text-primary fw-bold btn-sm">
                <i class="fas fa-arrow-left"></i> Volver a la Lista
            </a>
        </div>

        <div class="card-body">
            <div class="row mb-4">
                <div class="col-md-6">
                    <h5 class="text-secondary border-bottom pb-2">Información del Cliente</h5>
                    <p class="mb-1"><strong><i class="fas fa-user me-2"></i>Cliente:</strong> @Html.DisplayFor(model => model.IdClienteNavigation.Nombre)</p>


                    <p class="mb-1"><strong><i class="fas fa-calendar-alt me-2"></i>Fecha:</strong> @Model.FechaPedido.ToString("d")</p>

                    <p class="mb-1"><strong><i class="fas fa-user-tag me-2"></i>Registrado por:</strong> @Html.DisplayFor(model => model.UsuarioRegistro)</p>
                </div>
                <div class="col-md-6">
                    <h5 class="text-secondary border-bottom pb-2">Estado y Total</h5>
                    <p class="mb-1">
                        <strong>Estado:</strong>
                        @if (Model.Estado == 1)
                        {
                            <span class="badge bg-success"><i class="fas fa-check"></i> Completado</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary"><i class="fas fa-ban"></i> Anulado</span>
                        }
                    </p>
                    <div class="mt-3 p-2 bg-light border rounded d-inline-block">
                        <h4 class="mb-0 text-success fw-bold">Total: @Model.Total.ToString("C2")</h4>
                    </div>
                </div>
            </div>

            <h5 class="text-secondary border-bottom pb-2 mt-4"><i class="fas fa-boxes me-2"></i>Productos en este Pedido</h5>

            <div class="table-responsive">
                <table class="table table-striped table-hover table-bordered mt-2 align-middle">
                    <thead class="table-dark">
                        <tr>
                            <th>Producto</th>
                            <th>Descripción</th>
                            <th class="text-center">Cantidad</th>
                            <th class="text-end">Precio Unit.</th>
                            <th class="text-end">Subtotal</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.DetallePedido != null && Model.DetallePedido.Any())
                        {
                            foreach (var item in Model.DetallePedido)
                            {
                                <tr>
                                    <td class="fw-bold text-primary">
                                        @item.IdProductoNavigation?.Nombre
                                    </td>
                                    <td class="text-muted small">
                                        @item.IdProductoNavigation?.Descripcion
                                    </td>
                                    <td class="text-center fw-bold">
                                        @item.Cantidad
                                    </td>
                                    <td class="text-end">
                                        @item.PrecioUnitario.ToString("C2")
                                    </td>
                                    <td class="text-end fw-bold text-success">
                                        @{
                                            var subtotal = item.Cantidad * item.PrecioUnitario;
                                        }
                                        @subtotal.ToString("C2")
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="5" class="text-center text-muted py-3">
                                    <i class="fas fa-info-circle me-1"></i> No hay detalles disponibles para este pedido.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <div class="card-footer bg-light text-end">
            <a asp-action="Edit" asp-route-id="@Model?.Id" class="btn btn-warning">
                <i class="fas fa-edit"></i> Editar Pedido
            </a>
        </div>
    </div>
</div>