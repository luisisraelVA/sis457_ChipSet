@model IEnumerable<WebChipset.Models.Pedido>

@{
    ViewData["Title"] = "Historial de Ventas";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />

<div class="container mt-5 pt-5">
    <div class="card shadow-sm">
        <div class="card-header bg-secondary text-white d-flex justify-content-between align-items-center">
            <h3 class="mb-0"><i class="fas fa-history me-2"></i>Historial de Ventas</h3>
            <a href="@Url.Action("NuevaVenta", "Ventas")" class="btn btn-success fw-bold">
                <i class="fas fa-cash-register"></i> Nueva Venta
            </a>
        </div>
        <form asp-action="Index" method="get" class="mb-3">
            <div class="input-group">
                <input type="text" name="buscar" value="@ViewData["BusquedaActual"]" class="form-control" placeholder="Buscar por Cliente o Número de Pedido...">
                <button class="btn btn-primary" type="submit"><i class="fas fa-search"></i> Buscar</button>
                <a asp-action="Index" class="btn btn-secondary"><i class="fas fa-sync"></i></a>
            </div>
        </form>
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-hover table-bordered align-middle">
                    <thead class="table-light">
                        <tr>
                            <th>Nº Pedido</th>
                            <th>Cliente</th>
                            <th>Fecha</th>
                            <th>Total</th>
                            <th>Estado</th>
                            <th class="text-center">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td class="fw-bold text-center">
                                    #@item.Id
                                </td>
                                <td>
                                    <i class="fas fa-user text-muted me-1"></i>
                                    @Html.DisplayFor(modelItem => item.IdClienteNavigation.Nombre)
                                </td>
                                <td>
                                    @item.FechaPedido.ToString("d")
                                </td>
                                <td class="text-end fw-bold text-success">
                                    @item.Total.ToString("C2")
                                </td>
                                <td class="text-center">
                                    @if (item.Estado == 1)
                                    {
                                        <span class="badge bg-success">Completado</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger">Anulado</span>
                                    }
                                </td>
                                <td class="text-center">
                                    <a asp-controller="Pedidoes" asp-action="Details" asp-route-id="@item.Id" class="btn btn-info btn-sm text-white" title="Ver Productos">
                                        <i class="fas fa-eye"></i> Ver Detalle
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>